# Log rotation for git-deploy-toolkit: installed as /etc/logrotate.d/git-deploy-luna on each deploy and run by
# the nightly logrotate timer. See deploy.conf for the rest of the deploy setup.
#
# Retention follows the MLP Vector Club privacy policy ("Log Data" in the Winterchilla repo,
# templates/about/privacy.html.twig): server logs are "kept for up to 14 days and discarded afterwards". The
# nginx access log holds visitor IP addresses and the error log can too. `daily` with `rotate 13` is what
# makes that "up to 14 days": the current file holds at most one day and the 13 rotated ones the 13 days
# before it, so nothing is older than 14 days. If the policy's number changes, change this to (days - 1).
#
# Not listed on purpose:
# - storage/logs/laravel-cli-*.log are per-day files from Laravel's `daily` channel, which prunes them itself
#   (`days` => 14 in config/logging.php), so logrotate has nothing to add.
# - storage/logs/laravel.log belongs to the `single` channel, which nothing here uses.
#
# `su` is required because storage/logs is group-writable, or logrotate skips the files as insecure (that is
# how the old hand-made entry ended up never rotating anything). nginx and PHP keep the files open, so copy
# and truncate instead of moving them.
@WORKTREE@/storage/logs/nginx-access.log
@WORKTREE@/storage/logs/nginx-error.log {
    su www-data www-data
    daily
    rotate 13
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
