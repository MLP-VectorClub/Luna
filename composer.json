{
    "name": "mlp-vectorclub/luna",
    "description": "Work-in-progress backend for the MLP-VectorClub's website",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "cebe/php-openapi": "^1.7",
        "creativeorange/gravatar": "~1.0",
        "darkaonline/l5-swagger": "^9.0",
        "ezyang/htmlpurifier": "^4.19",
        "hisorange/browser-detect": "^5.0",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.16",
        "laravel/tinker": "^2.10",
        "laravel/ui": "^4.6",
        "mailerlite/laravel-elasticsearch": "^12.0",
        "marvinlabs/laravel-discord-logger": "^1.4",
        "monicahq/laravel-cloudflare": "^4.0",
        "qcod/laravel-settings": "^1.2",
        "seinopsys/rgbacolor": "^1.0",
        "socialiteproviders/deviantart": "^4.2",
        "socialiteproviders/discord": "^4.2",
        "spatie/eloquent-sortable": "^4.4",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-responsecache": "^7.6",
        "valorin/pwned-validator": "^1.3",
        "webpatser/laravel-uuid": "^4.0.1"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.5",
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5",
        "roave/security-advisories": "dev-latest"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/permissions.php",
            "app/Helpers/strings.php",
            "app/Helpers/time.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan generate-helpers"
        ]
    }
}
