parameters:
	ignoreErrors:
		-
			message: '#^Method App\\Console\\Commands\\ClearCommitCache\:\:handle\(\) should return int but return statement is missing\.$#'
			identifier: return.missing
			count: 1
			path: app/Console/Commands/ClearCommitCache.php

		-
			message: '#^Result of static method Illuminate\\Support\\Facades\\File\:\:replace\(\) \(void\) is used\.$#'
			identifier: staticMethod.void
			count: 2
			path: app/Console/Commands/GenerateEnumDocblocks.php

