APP_NAME=Luna
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.domain.tld
FRONTEND_URL=http://localhost:3000
CDN_URL=http://cdn-domain.tld

LOG_CHANNEL=stack
LOG_DISCORD_WEBHOOK_URL=

DB_CONNECTION=pgsql
DB_DATABASE=luna
DB_USERNAME=luna
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=sync
SESSION_DOMAIN=localhost
SESSION_DRIVER=cookie

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

DEVIANTART_CLIENT_ID=
DEVIANTART_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_SERVER_ID=

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Leave empty for STARTTLS when offered, smtps for implicit TLS (port 465)
MAIL_SCHEME=
# The same values as Winterchilla's MAIL_HOST/MAIL_PORT/MAIL_USERNAME/MAIL_PASSWORD work here. MAIL_FROM is accepted as an alias of MAIL_FROM_ADDRESS
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Penny Curve"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
